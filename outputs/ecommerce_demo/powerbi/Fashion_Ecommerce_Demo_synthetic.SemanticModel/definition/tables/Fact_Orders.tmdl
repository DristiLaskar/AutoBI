table Fact_Orders

	measure Records = COUNTROWS('Fact_Orders')
		formatString: #,0
		displayFolder: KPIs

	measure 'Unique Orders' = DISTINCTCOUNT('Fact_Orders'[order_id])
		formatString: #,0
		displayFolder: KPIs

	measure 'Total net amount' = SUM('Fact_Orders'[net_amount])
		formatString: #,0
		displayFolder: KPIs

	measure 'Total mrp' = SUMX('Fact_Orders', RELATED('Dim_Products'[mrp]))
		formatString: #,0
		displayFolder: KPIs

	measure 'Avg net amount per Record' = AVERAGE('Fact_Orders'[net_amount])
		formatString: #,0.00
		displayFolder: KPIs

	measure 'Avg discount pct' = AVERAGE('Fact_Orders'[discount_pct])
		formatString: 0.0%
		displayFolder: Rates

	measure 'returned Rate' = AVERAGE('Fact_Orders'[returned])
		formatString: 0.00%
		displayFolder: Rates

	measure 'Avg age' = AVERAGEX('Fact_Orders', RELATED('Dim_Customers'[age]))
		formatString: #,0.00
		displayFolder: KPIs

	measure 'net amount % of Total' = DIVIDE([Total net amount], CALCULATE([Total net amount], ALLSELECTED()))
		formatString: 0.0%
		displayFolder: KPIs

	measure 'net amount MoM %' = VAR cur = [Total net amount] VAR prev = CALCULATE([Total net amount], DATEADD('Dim_Date'[Date], -1, MONTH)) RETURN IF(NOT ISBLANK(prev), DIVIDE(cur - prev, prev))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	measure 'net amount YTD' = TOTALYTD([Total net amount], 'Dim_Date'[Date])
		formatString: #,0
		displayFolder: Time Intelligence

	measure 'returned Count' = SUM('Fact_Orders'[returned])
		formatString: #,0
		displayFolder: Rates

	measure 'returned Lift vs Overall' = DIVIDE([returned Rate], CALCULATE([returned Rate], ALLSELECTED()))
		formatString: 0.00"x"
		displayFolder: Rates

	column order_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: order_id

	column order_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: order_date

	column customer_id
		dataType: string
		summarizeBy: none
		sourceColumn: customer_id

	column product_id
		dataType: string
		summarizeBy: none
		sourceColumn: product_id

	column quantity
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: quantity

	column discount_pct
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: discount_pct

	column net_amount
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: net_amount

	column returned
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: returned

	partition Fact_Orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\Fact_Orders.csv"), [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"order_id", Int64.Type}, {"order_date", type date}, {"customer_id", type text}, {"product_id", type text}, {"quantity", Int64.Type}, {"discount_pct", type number}, {"net_amount", type number}, {"returned", Int64.Type}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
