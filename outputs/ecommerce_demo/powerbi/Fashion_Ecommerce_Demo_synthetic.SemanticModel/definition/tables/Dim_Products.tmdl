table Dim_Products

	column product_id
		dataType: string
		summarizeBy: none
		sourceColumn: product_id

	column brand
		dataType: string
		summarizeBy: none
		sourceColumn: brand

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column mrp
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: mrp

	partition Dim_Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\Dim_Products.csv"), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"product_id", type text}, {"brand", type text}, {"category", type text}, {"mrp", Int64.Type}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
