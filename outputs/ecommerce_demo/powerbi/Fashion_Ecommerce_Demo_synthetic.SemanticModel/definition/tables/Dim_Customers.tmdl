table Dim_Customers

	column customer_id
		dataType: string
		summarizeBy: none
		sourceColumn: customer_id

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column gender
		dataType: string
		summarizeBy: none
		sourceColumn: gender

	column age
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: age

	column signup_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: signup_date

	column age_Group
		dataType: string
		summarizeBy: none
		sourceColumn: age_Group

	partition Dim_Customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\Dim_Customers.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"customer_id", type text}, {"city", type text}, {"gender", type text}, {"age", Int64.Type}, {"signup_date", type date}, {"age_Group", type text}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
