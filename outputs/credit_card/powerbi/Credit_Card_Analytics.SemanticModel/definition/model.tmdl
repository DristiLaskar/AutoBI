model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Fact_Credit_Card", "Dim_Customer", "Dim_Date"]

ref expression DataFolder
ref table Fact_Credit_Card
ref table Dim_Customer
ref table Dim_Date
